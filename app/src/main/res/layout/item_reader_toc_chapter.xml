<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Left: Index + Chapter Title -->
        <TextView
            android:id="@+id/tvTocChapterTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="29. Chương 37: Bị Thương"
            android:textColor="#333333"
            android:textSize="15sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Right Column: Start Page & Global Page Info if active -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvTocStartPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="316"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvTocActiveGlobalPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="320/8387"
                android:textColor="#1E88E5"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:background="#EFEFEF" />

</LinearLayout>
