<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bar_bg"
    tools:context=".MainActivity">

    <!-- ViewPager2 Host Container for Fragments (FilesFragment / TransferFragment / SettingsFragment) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bannerContainer" />

    <!-- Banner Ad Container -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_above="@id/mainBottomNav"
        android:background="@color/white"
        android:elevation="6dp" />

    <FrameLayout
        android:id="@+id/mrecContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/mainBottomNav"
        android:elevation="5dp" />

    <!-- iOS style tab bar (Các tập tin / Chuyển tệp / Cài đặt) -->
    <LinearLayout
        android:id="@+id/mainBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/ios_tab_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:outlineProvider="none">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:background="@color/ios_tab_separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:orientation="horizontal">

            <!-- Item 1: Các tập tin -->
            <LinearLayout
                android:id="@+id/btnMainFilesTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="5dp">

                <ImageView
                    android:id="@+id/imgNavFilesIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/files"
                    android:src="@drawable/ic_tab_files"
                    app:tint="@color/ios_tab_selected" />

                <TextView
                    android:id="@+id/tvNavFilesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/files"
                    android:textColor="@color/ios_tab_selected"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Item 2: Chuyển tệp -->
            <LinearLayout
                android:id="@+id/btnMainTransferTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="5dp">

                <ImageView
                    android:id="@+id/imgNavTransferIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/file_transfer"
                    android:src="@drawable/ic_tab_transfer"
                    app:tint="@color/ios_tab_unselected" />

                <TextView
                    android:id="@+id/tvNavTransferLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/file_transfer"
                    android:textColor="@color/ios_tab_unselected"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Item 3: Cài đặt -->
            <LinearLayout
                android:id="@+id/btnMainSettingsTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="5dp">

                <ImageView
                    android:id="@+id/imgNavSettingsIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_tab_settings"
                    app:tint="@color/ios_tab_unselected" />

                <TextView
                    android:id="@+id/tvNavSettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/settings"
                    android:textColor="@color/ios_tab_unselected"
                    android:textSize="10.5sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
