<?xml version="1.0" encoding="utf-8"?>
<!-- "Chia sẻ tệp tin iTunes": copy files from a computer over USB into the app folder, then import -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_bg"
    android:orientation="vertical">

    <!-- Navigation bar (status bar inset is added as top padding in code) -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ios_bar_bg"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/layoutUsbNavBar"
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <LinearLayout
                android:id="@+id/btnUsbBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_back" />

                <TextView
                    android:id="@+id/tvUsbBackLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxLines="1"
                    android:text="@string/file_transfer"
                    android:textColor="@color/ios_blue"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- Margins are adjusted in code (fitNavigationTitle) -->
            <TextView
                android:id="@+id/tvUsbTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="112dp"
                android:layout_marginEnd="112dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/itunes_file_sharing"
                android:textColor="@color/ios_label"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnUsbRefresh"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="16dp"
                android:text="@string/refresh"
                android:textColor="@color/ios_blue"
                android:textSize="17sp" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:background="@color/ios_bar_separator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_transfer_usb" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/usb_header"
                    android:textColor="@color/ios_label"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/usb_header_sub"
                    android:textColor="@color/ios_placeholder"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/guide"
                android:textAllCaps="true"
                android:textColor="@color/ios_placeholder"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/usb_step_1"
                    android:textColor="@color/ios_label"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/usb_step_2"
                    android:textColor="@color/ios_label"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/usb_step_3"
                    android:textColor="@color/ios_label"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvUsbPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_ios_path_box"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:text="…"
                    android:textColor="@color/ios_label"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnCopyPath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/copy_path"
                    android:textColor="@color/ios_blue"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/usb_mac_note"
                    android:textColor="@color/ios_placeholder"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/usb_step_4"
                    android:textColor="@color/ios_label"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/pending_files"
                android:textAllCaps="true"
                android:textColor="@color/ios_placeholder"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/layoutPendingFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_card"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNoPending"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="@string/usb_no_files"
                    android:textColor="@color/ios_placeholder"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom button (navigation bar inset is added as bottom padding in code) -->
    <FrameLayout
        android:id="@+id/layoutUsbBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ios_grouped_bg"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnUsbImport"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_ios_button_primary"
            android:enabled="false"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/usb_import_none"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </FrameLayout>

</LinearLayout>
