<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_bg"
    android:orientation="vertical">

    <!-- Navigation bar (same style as "Các tập tin") -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/ios_bar_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="@string/file_transfer"
            android:textColor="@color/ios_label"
            android:textSize="17sp" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:background="@color/ios_bar_separator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.6dp"
                    android:background="@color/ios_row_separator" />

            <LinearLayout
                android:id="@+id/btnOptionIcloud"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_ios_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_transfer_files" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/files_icloud_drive"
                        android:textColor="@color/ios_label"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/import_files_icloud_drive"
                        android:textColor="@color/ios_placeholder"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginStart="62dp"
                android:background="@color/ios_row_separator" />

            <LinearLayout
                android:id="@+id/btnOptionWifi"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_ios_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_transfer_wifi" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/wifi_transfer"
                        android:textColor="@color/ios_label"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/import_from_pc"
                        android:textColor="@color/ios_placeholder"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginStart="62dp"
                android:background="@color/ios_row_separator" />

            <LinearLayout
                android:id="@+id/btnOptionItunes"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_ios_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_transfer_usb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/itunes_file_sharing"
                        android:textColor="@color/ios_label"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/import_from_pc"
                        android:textColor="@color/ios_placeholder"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginStart="62dp"
                android:background="@color/ios_row_separator" />

            <LinearLayout
                android:id="@+id/btnOptionDropbox"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_ios_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_transfer_cloud"
                    app:tint="@color/dropbox_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/dropbox"
                        android:textColor="@color/ios_label"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/support_batch_upload"
                        android:textColor="@color/ios_placeholder"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnInfoDropbox"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="-11dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/support_batch_upload"
                    android:padding="11dp"
                    android:src="@drawable/ic_ios_info" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginStart="62dp"
                android:background="@color/ios_row_separator" />

            <LinearLayout
                android:id="@+id/btnOptionDrive"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_ios_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_transfer_cloud"
                    app:tint="@color/drive_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/google_drive"
                        android:textColor="@color/ios_label"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/support_batch_upload"
                        android:textColor="@color/ios_placeholder"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnInfoDrive"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="-11dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/support_batch_upload"
                    android:padding="11dp"
                    android:src="@drawable/ic_ios_info" />
            </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.6dp"
                    android:background="@color/ios_row_separator" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/transfer_footer"
                android:textColor="@color/ios_placeholder"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
