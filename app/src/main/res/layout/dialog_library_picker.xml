<?xml version="1.0" encoding="utf-8"?>
<!-- Choose library files to upload (Dropbox / Google Drive batch upload) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ios_bar_bg"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/layoutPickerNavBar"
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <TextView
                android:id="@+id/btnPickerCancel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:text="@string/cancel"
                android:textColor="@color/ios_blue"
                android:textSize="17sp" />

            <!-- Margins are adjusted in code (fitNavigationTitle) -->
            <TextView
                android:id="@+id/tvPickerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="96dp"
                android:layout_marginEnd="96dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/select_files"
                android:textColor="@color/ios_label"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnPickerDone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="16dp"
                android:text="@string/upload"
                android:textColor="@color/ios_blue"
                android:textSize="17sp" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:background="@color/ios_bar_separator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvPickerCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ios_placeholder"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnPickerSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/select_all"
            android:textColor="@color/ios_blue"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPickerFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvPickerEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_files_yet"
            android:textColor="@color/ios_placeholder"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
