<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FB">

    <LinearLayout
        android:id="@+id/files_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header: Search / SelectAll (Left) | Các tập tin (Center) | + Sửa / Xong (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/white">

            <ImageView
                android:id="@+id/btnMainSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_search"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search" />

            <ImageView
                android:id="@+id/btnSelectAll"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/bg_circle_blue"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Select All" />

            <TextView
                android:id="@+id/tvMainHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Các tập tin"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnAddFile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@android:drawable/ic_input_add"
                app:tint="#1E88E5"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add" />

            <TextView
                android:id="@+id/btnEditFiles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Sửa"
                android:textColor="#1E88E5"
                android:textSize="16sp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Storage Sub-Header & Sort Segmented Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#F2F2F6">

            <TextView
                android:id="@+id/tvFreeStorageSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Không gian trống\n14.67 GB"
                android:textColor="#666666"
                android:textSize="11sp"
                android:maxLines="2" />

            <!-- Sort Segmented Control Bar: Tên | Thể loại | Thời gian -->
            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:padding="2dp"
                android:background="#E5E5EA">

                <TextView
                    android:id="@+id/tabSortName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Tên"
                    android:textColor="#222222"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_segmented_tab_active" />

                <TextView
                    android:id="@+id/tabSortType"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Thể loại"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:background="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/tabSortTime"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Thời gian"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>

        </LinearLayout>

        <!-- Main Files List Area -->
        <FrameLayout
            android:id="@+id/anchor_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white">

            <!-- Files RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMainFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="64dp" />

            <!-- Empty State View -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_document"
                    app:tint="#CCCCCC"
                    android:contentDescription="Empty" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Chưa có tập tin nào"
                    android:textColor="#888888"
                    android:textSize="15sp" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Bottom Multi-Select Action Bar (Shown in Edit Mode) -->
    <LinearLayout
        android:id="@+id/layoutEditActionBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FAFAFA"
        android:elevation="12dp"
        android:visibility="gone">

        <!-- Action 1: Chia sẻ -->
        <LinearLayout
            android:id="@+id/btnActionShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_share"
                app:tint="#1E88E5"
                android:contentDescription="Share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chia sẻ"
                android:textColor="#1E88E5"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Action 2: di chuyển đến thư mục -->
        <LinearLayout
            android:id="@+id/btnActionMove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#1E88E5"
                android:contentDescription="Move" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="di chuyển đến thư mục"
                android:textColor="#1E88E5"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Action 3: Sao chép -->
        <LinearLayout
            android:id="@+id/btnActionCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#1E88E5"
                android:contentDescription="Copy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sao chép"
                android:textColor="#1E88E5"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Action 4: Zip -->
        <LinearLayout
            android:id="@+id/btnActionZip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_save"
                app:tint="#1E88E5"
                android:contentDescription="Zip" />

            <TextView
                android:id="@+id/tvActionZipLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Zip"
                android:textColor="#1E88E5"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Action 5: Xóa bỏ -->
        <LinearLayout
            android:id="@+id/btnActionDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#1E88E5"
                android:contentDescription="Delete" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Xóa bỏ"
                android:textColor="#1E88E5"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
