<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_bg">

    <LinearLayout
        android:id="@+id/files_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== Navigation bar ===== -->
        <FrameLayout
            android:id="@+id/layoutNavBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/ios_bar_bg">

            <!-- Normal / edit: [Search | Select all]   Các tập tin   [+] [Sửa | Xong] -->
            <RelativeLayout
                android:id="@+id/layoutNavNormal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/btnMainSearch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="7dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search"
                    android:padding="11dp"
                    android:src="@drawable/ic_ios_search" />

                <ImageView
                    android:id="@+id/btnSelectAll"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="5dp"
                    android:alpha="0"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/select_all"
                    android:padding="11dp"
                    android:src="@drawable/ic_ios_select_all"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMainHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/files"
                    android:textColor="@color/ios_label"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/btnEditFiles"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:minWidth="44dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="18dp"
                    android:text="@string/edit"
                    android:textColor="@color/ios_blue"
                    android:textSize="17sp" />

                <ImageView
                    android:id="@+id/btnAddFile"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_toStartOf="@id/btnEditFiles"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/add_file"
                    android:padding="13dp"
                    android:src="@drawable/ic_ios_plus" />
            </RelativeLayout>

            <!-- Search mode: [🔍 Tìm kiếm      ⓧ]  Hủy -->
            <LinearLayout
                android:id="@+id/layoutNavSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_search_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ios_search"
                        app:tint="@color/ios_placeholder" />

                    <EditText
                        android:id="@+id/etSearchFiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textColor="@color/ios_label"
                        android:textColorHighlight="#4D007AFF"
                        android:textColorHint="@color/ios_placeholder"
                        android:textCursorDrawable="@drawable/bg_ios_cursor"
                        android:textSize="17sp" />

                    <ImageView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/clear_search"
                        android:padding="5dp"
                        android:src="@drawable/ic_ios_clear"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnCancelSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:text="@string/cancel"
                    android:textColor="@color/ios_blue"
                    android:textSize="17sp" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:background="@color/ios_bar_separator" />

        <!-- ===== Free space + sort segmented control (content hidden in edit mode, band stays) ===== -->
        <FrameLayout
            android:id="@+id/layoutSubHeader"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/ios_grouped_bg">

            <LinearLayout
                android:id="@+id/layoutSortHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingEnd="9.5dp">

                <TextView
                    android:id="@+id/tvFreeStorageSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="0.92"
                    android:maxLines="2"
                    android:textColor="@color/ios_label"
                    android:textSize="12.5sp"
                    tools:text="Không gian trống\n14.67 GB" />

                <!-- Tên | Thể loại | Thời gian -->
                <FrameLayout
                    android:id="@+id/layoutSortSegment"
                    android:layout_width="0dp"
                    android:layout_height="29dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_segment_container"
                    android:padding="2dp">

                    <!-- Selected segment (slides with translationX, positioned from the left in code) -->
                    <View
                        android:id="@+id/viewSortThumb"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="left"
                        android:background="@drawable/bg_ios_segment_selected"
                        tools:ignore="RtlHardcoded" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tabSortName"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/name"
                            android:textColor="@color/ios_label"
                            android:textSize="13sp" />

                        <View
                            android:id="@+id/viewSortDivider1"
                            android:layout_width="0.6dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/ios_segment_divider"
                            android:visibility="invisible" />

                        <TextView
                            android:id="@+id/tabSortType"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/category"
                            android:textColor="@color/ios_label"
                            android:textSize="13sp" />

                        <View
                            android:id="@+id/viewSortDivider2"
                            android:layout_width="0.6dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/ios_segment_divider" />

                        <TextView
                            android:id="@+id/tabSortTime"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/time"
                            android:textColor="@color/ios_label"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ===== File list ===== -->
        <FrameLayout
            android:id="@+id/anchor_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMainFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />

            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="51dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_file_doc_stroke"
                    app:tint="#C7C7CC" />

                <TextView
                    android:id="@+id/tvEmptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/no_files_yet"
                    android:textColor="@color/ios_placeholder"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ===== Edit mode bottom bar: Chia sẻ | di chuyển đến thư mục | Sao chép | Zip | Xóa bỏ ===== -->
    <LinearLayout
        android:id="@+id/layoutEditActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/ios_action_bar_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:background="@color/ios_action_bar_separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:id="@+id/btnActionShare"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_action_share" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/share"
                    android:textColor="@color/ios_blue"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="6sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnActionMove"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_action_move" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/move_to_folder"
                    android:textColor="@color/ios_blue"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="6sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnActionCopy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_action_copy" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/copy"
                    android:textColor="@color/ios_blue"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="6sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnActionZip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_action_zip" />

                <TextView
                    android:id="@+id/tvActionZipLabel"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/zip"
                    android:textColor="@color/ios_blue"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="6sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnActionDelete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_action_delete" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/delete"
                    android:textColor="@color/ios_blue"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="6sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
