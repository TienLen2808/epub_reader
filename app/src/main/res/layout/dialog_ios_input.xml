<?xml version="1.0" encoding="utf-8"?>
<!-- iOS alert with a text field (rename) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutInputRoot"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ios_alert"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvInputTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="19dp"
        android:paddingEnd="16dp"
        android:textColor="@color/ios_label"
        android:textSize="17sp"
        tools:text="Đổi tên" />

    <TextView
        android:id="@+id/tvInputMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/ios_label"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Message" />

    <EditText
        android:id="@+id/etInput"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_ios_text_field"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="7dp"
        android:paddingTop="0dp"
        android:paddingEnd="7dp"
        android:paddingBottom="0dp"
        android:textColor="@color/ios_label"
        android:textColorHighlight="#4D007AFF"
        android:textColorHint="@color/ios_placeholder"
        android:textCursorDrawable="@drawable/bg_ios_cursor"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:background="@color/ios_alert_separator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnInputNegative"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_ios_alert_button"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/cancel"
            android:textColor="@color/ios_blue"
            android:textSize="17sp" />

        <View
            android:layout_width="0.6dp"
            android:layout_height="match_parent"
            android:background="@color/ios_alert_separator" />

        <TextView
            android:id="@+id/btnInputPositive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_ios_alert_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/save"
            android:textColor="@color/ios_blue"
            android:textSize="17sp" />
    </LinearLayout>

</LinearLayout>
