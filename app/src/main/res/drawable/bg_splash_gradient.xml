<?xml version="1.0" encoding="utf-8"?>
<!-- Splash background: light orange at the top to coral at the bottom -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/splash_gradient_center"
        android:endColor="@color/splash_gradient_bottom"
        android:startColor="@color/splash_gradient_top"
        android:type="linear" />
</shape>
