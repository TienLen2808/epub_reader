<?xml version="1.0" encoding="utf-8"?>
<!-- Window background of the splash (shown before the layout on Android 11 and older):
     the gradient with the logo exactly where SplashActivity starts its animation -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_splash_gradient" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/splash_icon"
        android:gravity="center" />
</layer-list>
